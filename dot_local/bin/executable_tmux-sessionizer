#!/usr/bin/env bash

if ! command -v sesh >/dev/null 2>&1; then
    echo "sesh is not installed. Install with: brew install sesh / yay -S fzf" >&2
    exit 1
fi

if [[ $1 == "--new" ]]; then
    project_name=$2
    if [[ -z $project_name ]]; then
        exit 0
    fi
    project_dir="$HOME/Projects/$project_name"
    mkdir -p "$project_dir"
    if command -v zoxide >/dev/null 2>&1; then
        zoxide add "$project_dir" >/dev/null 2>&1 || true
    fi
    exec sesh connect "$project_dir"
fi

if [[ $# -ge 1 ]]; then
    selected=$1
else
    if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf is not installed. Install with: brew install fzf / yay -S fzf" >&2
        exit 1
    fi
    selected=$(sesh list | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

if [[ -d $selected ]] && command -v zoxide >/dev/null 2>&1; then
    zoxide add "$selected" >/dev/null 2>&1 || true
fi

exec sesh connect "$selected"
