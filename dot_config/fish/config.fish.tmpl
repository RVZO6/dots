{{- if eq .chezmoi.os "darwin" }}
# homebrew
fish_add_path /opt/homebrew/bin
fish_add_path /opt/homebrew/sbin
set -gx HOMEBREW_NO_AUTO_UPDATE 1
set -gx HOMEBREW_NO_ANALYTICS 1
set -gx HOMEBREW_NO_INSECURE_REDIRECT 1
set -gx HOMEBREW_NO_ENV_HINTS 1
set -gx HOMEBREW_NO_ANALYTICS_MESSAGE 1
set -gx HOMEBREW_INSTALL_BADGE ""
set -gx HOMEBREW_VERBOSE ""
{{- end }}

# bob nvim path
fish_add_path $HOME/.local/share/bob/nvim-bin

# Local bin PATH
fish_add_path $HOME/.local/bin

# Editor
set -gx EDITOR nvim
alias nvim-old='NVIM_APPNAME=nvim-old nvim'
alias nvim-pkazmier='NVIM_APPNAME=nvim-pkazmier nvim'
# https://github.com/pkazmier/nvim

# aliases
alias c='chezmoi'
alias ce='chezmoi edit'
alias ca='chezmoi apply'
alias cra='chezmoi re-add'

# Shell
set -gx SHELL (status fish-path)

# Fish options
set -g fish_greeting # Disable banner

# Vi mode
set -g fish_key_bindings fish_vi_key_bindings
set -g fish_cursor_insert line
set -g fish_cursor_default block
set -g fish_cursor_visual block
set -g fish_cursor_replace_one underscore

# Man pages
set -gx MANPAGER 'nvim +Man!'

# Starship
if command -v starship >/dev/null
    starship init fish | source
end

# Zoxide
if command -v zoxide >/dev/null
    zoxide init fish | source
end

# Yazi
function y
	set tmp (mktemp -t "yazi-cwd.XXXXXX")
	command yazi $argv --cwd-file="$tmp"
	if read -z cwd < "$tmp"; and [ -n "$cwd" ]; and [ "$cwd" != "$PWD" ]
		builtin cd -- "$cwd"
	end
	rm -f -- "$tmp"
end

if command -v eza >/dev/null
    alias ls='eza -lh --group-directories-first --icons=auto'
    alias lsa='ls -a'
    alias lt='eza --tree --level=2 --long --icons --git'
    alias lta='lt -a'
end

# Keybindings
function fish_user_key_bindings
    # Ctrl+F: tmux-sessionizer
    bind -M insert \cf "~/.local/bin/tmux-sessionizer; commandline -f repaint"
    bind \cf "~/.local/bin/tmux-sessionizer; commandline -f repaint"
    # Ctrl+O: yazi
    bind -M insert \co "y; commandline -f repaint"
    bind \co "y; commandline -f repaint"
		# vim mode shenanigans
		bind -M insert \cy accept-autosuggestion
    bind -M default \cy accept-autosuggestiond
end

# Cargo
if test -d "$HOME/.cargo/bin"
    fish_add_path "$HOME/.cargo/bin"
end

# FZF colors (vague colorscheme)
set -gx FZF_DEFAULT_OPTS "--color=fg:#cdcdcd --color=bg: --color=hl:#f3be7c --color=fg+:#aeaed1 --color=bg+: --color=hl+:#f3be7c --color=border:#606079 --color=header:#6e94b2 --color=gutter: --color=spinner:#7fa563 --color=info:#f3be7c --color=pointer:#aeaed1 --color=marker:#d8647e --color=prompt:#bb9dbd"

