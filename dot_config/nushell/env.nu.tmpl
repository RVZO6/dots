# Shell
$env.SHELL = (which nu | first | get path)

# Homebrew PATH (macOS only)
{{ if eq .chezmoi.os "darwin" }}
$env.PATH = ($env.PATH | split row (char esep) | prepend '/opt/homebrew/bin' | prepend '/opt/homebrew/sbin')
{{ end }}

# BOB PATH
$env.PATH = ($env.PATH | split row (char esep) | prepend $"($env.HOME)/.local/share/bob/nvim-bin")

# Editor
$env.EDITOR = 'nvim'

# Prompt indicators
$env.PROMPT_INDICATOR_VI_INSERT = ""
$env.PROMPT_INDICATOR_VI_NORMAL = ""

# Homebrew - quiet by default, only show relevant info
$env.HOMEBREW_NO_ANALYTICS = "1"          # No analytics messages
$env.HOMEBREW_NO_AUTO_UPDATE = "1"        # Don't auto-update before installs
$env.HOMEBREW_NO_ENV_HINTS = "1"          # No "set PATH" suggestions
$env.HOMEBREW_NO_ANALYTICS_MESSAGE = "1"  # No analytics disabled notice
$env.HOMEBREW_INSTALL_BADGE = ""          # Remove 🍺 emoji
$env.HOMEBREW_VERBOSE = ""                # Disable verbose output
