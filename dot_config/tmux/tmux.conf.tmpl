# Core
set -g mouse on
set -g detach-on-destroy off

# Terminal
set -g default-terminal "xterm-ghostty"

# Prefix
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

# Indexing
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Copy mode!!!
set -g mode-keys vi
bind -T copy-mode-vi Escape send-keys -X cancel

# Key bindings
bind = split-window -h
bind - split-window -v
# window stuff
bind -n M-h resize-pane -L 5
bind -n M-j resize-pane -D 2
bind -n M-k resize-pane -U 2
bind -n M-l resize-pane -R 5
bind -n C-h select-pane -L
bind -n C-j select-pane -D
bind -n C-k select-pane -U
bind -n C-l select-pane -R
bind -n C-j 
bind r source-file "~/.config/tmux/tmux.conf" \; display-message "Config reloaded!"
bind f run-shell "tmux neww ~/.local/bin/tmux-sessionizer"
bind p command-prompt -p "Project name:" "run-shell \"~/.local/bin/tmux-sessionizer --new '%1'\""
bind Q confirm-before -p "Kill the entire tmux server? (y/n)" "kill-server"
bind x kill-pane
bind X kill-window
bind -r j previous-window
bind -r k next-window
bind g display-popup -d "#{pane_current_path}" -w 80% -h 80% -E "lazygit"
bind Tab last-window
bind Space switch-client -l
bind + resize-pane -Z
bind S command-prompt "new-session -s '%%' -c ~"
# figure out how to rename session and change default dir for new windows and panes

{{- if eq .chezmoi.os "darwin" }}
bind y run-shell "pwd | tr -d '\n' | pbcopy"
bind Y run-shell "tmux display-message -p '#{pane_current_path}' | tr -d '\n' | pbcopy"
{{- else }}
bind y run-shell "pwd | tr -d '\n' | wl-copy"
bind Y run-shell "tmux display-message -p '#{pane_current_path}' | tr -d '\n' | wl-copy"
{{- end }}

bind -r l run-shell "~/.local/bin/tmux-sessionizer ~/Downloads"
bind -r L run-shell "~/.local/bin/tmux-sessionizer ~/Documents"
bind -r o run-shell "~/.local/bin/tmux-sessionizer ~/Desktop"
bind -r z run-shell "~/.local/bin/tmux-sessionizer ~/.local/share/chezmoi"
bind -r v run-shell "~/.local/bin/tmux-sessionizer ~/vault"

# Status
set -g status-position top
set -g status-justify absolute-centre
# transparent bg
set -g status-style "bg=default"

# session name on left
set -g status-left "#S "
# nothing on right
set -g status-right ""

setw -g window-status-style "fg=brightblack"
setw -g window-status-current-style "fg=green,bg=default,bold"

set -g mode-style 'bold,fg=yellow, bg=default'
set -g message-style 'bold,fg=yellow,bg=default'
set -g message-command-style 'bold,fg=yellow,bg=default'
set -ga terminal-overrides ',*:Cs=\E]12;%p1%s\007:Cr=\E]112\007'
